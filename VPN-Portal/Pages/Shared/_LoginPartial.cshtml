@using Microsoft.AspNetCore.Identity
@using VPN_Portal.Authentication
@using VPN_Portal.Services
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject UserInfo UserInfo

<ul class="navbar-nav ms-auto">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle nav-hover-effect px-3 d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fa-solid fa-user-circle me-2"></i>
                <span>@(UserInfo.DisplayName ?? User.Identity?.Name)</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2" aria-labelledby="userDropdown">
                <li>
                    <a class="dropdown-item py-2" asp-area="Identity" asp-page="/Account/Manage/Index">
                        <i class="fa-solid fa-user-gear me-2 text-primary"></i>My Account
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form class="px-3" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })" method="post">
                        <button type="submit" class="btn btn-danger btn-sm w-100">
                            <i class="fa-solid fa-right-from-bracket me-1"></i>Logout
                        </button>
                    </form>
                </li>
            </ul>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link nav-hover-effect px-3" asp-area="Identity" asp-page="/Account/Login">
                <i class="fa-solid fa-right-to-bracket me-1"></i>Login
            </a>
        </li>
    }
</ul>