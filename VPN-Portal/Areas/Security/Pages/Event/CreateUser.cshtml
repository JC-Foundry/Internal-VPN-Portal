@page "{eventId}"
@model VPN_Portal.Areas.Security.Pages.Event.CreateUser

@{
    ViewData["Title"] = "Create User Event";
}

<div class="container-fluid">
    <div class="mb-3">
        <a href="/Security" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-2"></i>Back to Events
        </a>
    </div>
    <div class="card border-0 shadow-lg">
        <div class="card-header bg-gradient-info text-white">
            <h3 class="mb-0 fw-bold">
                <i class="fa-solid fa-user-plus me-3"></i>User Creation Event Details
            </h3>
        </div>
        <div class="card-body p-4">
            <!-- Event-Specific Properties (Centered) -->
            <div class="text-center mb-4 pb-4 border-bottom">
                <h5 class="text-uppercase text-muted mb-3">Event Details</h5>
                <div class="d-flex justify-content-center align-items-center">
                    <i class="fa-solid @GetCreatedByIcon(Model.SecurityEvent.CreatedBy) fa-2x me-3 text-primary"></i>
                    <div>
                        <span class="badge bg-@GetCreatedByBadgeClass(Model.SecurityEvent.CreatedBy) fs-5">
                            @Model.SecurityEvent.CreatedBy.ToString()
                        </span>
                        <div class="small text-muted mt-1">User Creation Method</div>
                    </div>
                </div>
            </div>

            <!-- Event Partial with Actions -->
            <partial name="Shared/_EventPartial" model="(Model.BaseEvent, Model.SecurityActions)"/>
        </div>
    </div>
</div>

@functions {
    string GetCreatedByIcon(VPN_Portal.Models.Security.CreatedUserType type) => type switch
    {
        VPN_Portal.Models.Security.CreatedUserType.Admin => "fa-user-shield",
        VPN_Portal.Models.Security.CreatedUserType.Register => "fa-user-pen",
        _ => "fa-question"
    };

    string GetCreatedByBadgeClass(VPN_Portal.Models.Security.CreatedUserType type) => type switch
    {
        VPN_Portal.Models.Security.CreatedUserType.Admin => "primary",
        VPN_Portal.Models.Security.CreatedUserType.Register => "warning",
        _ => "secondary"
    };
}