@page
@model VPN_Portal.Areas.Admin.Pages.DNS.IndexModel
@{
    ViewData["Title"] = "DNS Overview";
    ViewData["ActivePage"] = AdminNavPages.DnsIndex;
    Layout = "../_Layout";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-gradient-primary text-white">
        <h4 class="mb-0 fw-semibold">
            <i class="fa-solid fa-globe me-2"></i>@ViewData["Title"]
        </h4>
    </div>
    <div class="card-body p-4">
        <!-- Statistics Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card bg-primary bg-opacity-10 border-0">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <i class="fa-solid fa-layer-group fa-2x text-primary me-3"></i>
                            <div>
                                <h5 class="mb-0">@Model.TotalPools</h5>
                                <small class="text-muted">DNS Pools</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success bg-opacity-10 border-0">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <i class="fa-solid fa-ethernet fa-2x text-success me-3"></i>
                            <div>
                                <h5 class="mb-0">@Model.ActiveReservations</h5>
                                <small class="text-muted">Active IPs</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-info bg-opacity-10 border-0">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <i class="fa-solid fa-check-circle fa-2x text-info me-3"></i>
                            <div>
                                <h5 class="mb-0">@Model.AvailableIPs</h5>
                                <small class="text-muted">Available IPs</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning bg-opacity-10 border-0">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <i class="fa-solid fa-percentage fa-2x text-warning me-3"></i>
                            <div>
                                <h5 class="mb-0">@Model.UtilizationRate%</h5>
                                <small class="text-muted">Utilization</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- DNS Pools -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fa-solid fa-layer-group me-2 text-primary"></i>DNS Pools
                    </h5>
                    <a href="#" class="btn btn-sm btn-primary">
                        <i class="fa-solid fa-plus me-1"></i>Add Pool
                    </a>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th class="border-0">Pool Name</th>
                                <th class="border-0">Network</th>
                                <th class="border-0">Subnet</th>
                                <th class="border-0">Total IPs</th>
                                <th class="border-0">Used</th>
                                <th class="border-0">Available</th>
                                <th class="border-0">Usage</th>
                                <th class="border-0">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pool in Model.DnsPools)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">
                                            <i class="fa-solid fa-network-wired me-2 text-primary"></i>@pool.Name
                                        </div>
                                    </td>
                                    <td>
                                        <code>@pool.Network</code>
                                    </td>
                                    <td>@pool.Subnet</td>
                                    <td>@pool.TotalIPs</td>
                                    <td>
                                        <span class="badge bg-success-subtle text-success">@pool.UsedIPs</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info-subtle text-info">@pool.AvailableIPs</span>
                                    </td>
                                    <td>
                                        <div class="progress" style="height: 20px; min-width: 100px;">
                                            <div class="progress-bar @(pool.UsagePercentage > 80 ? "bg-danger" : pool.UsagePercentage > 60 ? "bg-warning" : "bg-success")" 
                                                 role="progressbar" 
                                                 style="width: @(pool.UsagePercentage)%">
                                                @pool.UsagePercentage%
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            <button type="button" class="btn btn-outline-primary" title="View">
                                                <i class="fa-solid fa-eye"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-warning" title="Edit">
                                                <i class="fa-solid fa-pen"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-danger" title="Delete">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Recent Reservations -->
        <div class="row g-3">
            <div class="col-md-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <i class="fa-solid fa-clock-rotate-left me-2 text-primary"></i>Recent Reservations
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            @foreach (var reservation in Model.RecentReservations)
                            {
                                <div class="list-group-item">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="fw-semibold">
                                                <code>@reservation.IPAddress</code>
                                            </div>
                                            <small class="text-muted">
                                                Device: @reservation.DeviceName | Pool: @reservation.PoolName
                                            </small>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge bg-success-subtle text-success">Active</span>
                                            <div>
                                                <small class="text-muted">@reservation.ReservedAt.ToString("MMM dd, h:mm tt")</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 bg-light">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">
                            <i class="fa-solid fa-chart-pie me-2 text-info"></i>IP Allocation
                        </h6>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <small>10.0.0.0/8</small>
                                <small class="text-muted">45%</small>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <div class="progress-bar bg-primary" style="width: 45%"></div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <small>172.16.0.0/12</small>
                                <small class="text-muted">62%</small>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <div class="progress-bar bg-warning" style="width: 62%"></div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <small>192.168.0.0/16</small>
                                <small class="text-muted">28%</small>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <div class="progress-bar bg-success" style="width: 28%"></div>
                            </div>
                        </div>
                        <hr>
                        <div class="d-grid">
                            <button class="btn btn-sm btn-outline-primary">
                                <i class="fa-solid fa-chart-line me-1"></i>View Details
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>