@page
@model VPN_Portal.Areas.Admin.Pages.DNS.IndexModel
@{
    ViewData["Title"] = "DNS Overview";
    ViewData["ActivePage"] = AdminNavPages.DnsIndex;
    Layout = "../_Layout";
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-gradient-primary text-white">
        <h4 class="mb-0 fw-semibold">
            <i class="fa-solid fa-globe me-2"></i>@ViewData["Title"]
        </h4>
    </div>
    <div class="card-body p-4">
        <!-- Statistics Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card bg-primary bg-opacity-10 border-0">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <i class="fa-solid fa-layer-group fa-2x text-primary me-3"></i>
                            <div>
                                <h5 class="mb-0">@Model.TotalPools</h5>
                                <small class="text-muted">DNS Pools</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-success bg-opacity-10 border-0">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <i class="fa-solid fa-ethernet fa-2x text-success me-3"></i>
                            <div>
                                <h5 class="mb-0">@Model.ActiveReservations</h5>
                                <small class="text-muted">Active IPs</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-info bg-opacity-10 border-0">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <i class="fa-solid fa-check-circle fa-2x text-info me-3"></i>
                            <div>
                                <h5 class="mb-0">@Model.AvailableIPs</h5>
                                <small class="text-muted">Available IPs</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card bg-warning bg-opacity-10 border-0">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <i class="fa-solid fa-percentage fa-2x text-warning me-3"></i>
                            <div>
                                <h5 class="mb-0">@Model.UtilizationRate%</h5>
                                <small class="text-muted">Utilization</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Last 10 Reservations -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fa-solid fa-clock-rotate-left me-2 text-primary"></i>Last 10 Reservations
                    </h5>
                    <a asp-area="Admin" asp-page="/DNS/Pools" class="btn btn-sm btn-primary">
                        <i class="fa-solid fa-list me-1"></i>View All
                    </a>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th class="border-0">IP Address</th>
                                <th class="border-0">User</th>
                                <th class="border-0">Device</th>
                                <th class="border-0">Pool</th>
                                <th class="border-0">Reserved At</th>
                                <th class="border-0">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentReservations.Any())
                            {
                                foreach (var reservation in Model.RecentReservations)
                                {
                                    <tr>
                                        <td>
                                            <code>@reservation.IPAddress</code>
                                        </td>
                                        <td>
                                            <div class="fw-semibold">
                                                <i class="fa-solid fa-user me-2 text-info"></i>@reservation.User
                                            </div>
                                        </td>
                                        <td>
                                            <div class="fw-semibold">
                                                <i class="fa-solid fa-laptop me-2 text-info"></i>@reservation.DeviceName
                                            </div>
                                        </td>
                                        <td>@reservation.PoolName</td>
                                        <td>
                                            <small class="text-muted">@reservation.ReservedAt.ToLocalTime().ToString("g")</small>
                                        </td>
                                        <td>
                                            @if (reservation.IsReleased)
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary">Released</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success">Active</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-3">No reservations found</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Top 5 Most Used DNS Pools -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-light">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fa-solid fa-chart-bar me-2 text-primary"></i>Top 5 Most Used DNS Pools
                    </h5>
                    <a asp-area="Admin" asp-page="/DNS/Pools" class="btn btn-sm btn-primary">
                        <i class="fa-solid fa-layer-group me-1"></i>Manage Pools
                    </a>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th class="border-0">Pool Name</th>
                                <th class="border-0">Subnet</th>
                                <th class="border-0">Total IPs</th>
                                <th class="border-0">Used</th>
                                <th class="border-0">Available</th>
                                <th class="border-0">Usage</th>
                                <th class="border-0">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TopDnsPools.Any())
                            {
                                @foreach (var pool in Model.TopDnsPools)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">
                                                <i class="fa-solid fa-network-wired me-2 text-primary"></i>@pool.Name
                                            </div>
                                        </td>
                                        <td>@pool.Subnet</td>
                                        <td>@pool.TotalIPs</td>
                                        <td>
                                            <span class="badge bg-success-subtle text-success">@pool.UsedIPs</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-info-subtle text-info">@pool.AvailableIPs</span>
                                        </td>
                                        <td>
                                            <div class="progress" style="height: 20px; min-width: 100px;">
                                                <div class="progress-bar @(pool.UsagePercentage > 80 ? "bg-danger" : pool.UsagePercentage > 60 ? "bg-warning" : "bg-success")" 
                                                     role="progressbar" 
                                                     style="width: @(pool.UsagePercentage)%">
                                                    @pool.UsagePercentage%
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="btn-group btn-group-sm" role="group">
                                                <a asp-area="Admin" asp-page="/DNS/Edit" asp-route-id="@pool.Id" class="btn btn-outline-primary" title="View">
                                                    <i class="fa-solid fa-eye"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted py-3">No DNS pools found</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="row g-3">
            <div class="col-md-12">
                <div class="card border-0 bg-light">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">
                            <i class="fa-solid fa-bolt me-2 text-warning"></i>Quick Actions
                        </h6>
                        <div class="row g-2">
                            <div class="col-auto">
                                <a asp-area="Admin" asp-page="/DNS/Pools" class="btn btn-sm btn-outline-primary">
                                    <i class="fa-solid fa-layer-group me-1"></i>Manage DNS Pools
                                </a>
                            </div>
                            <div class="col-auto">
                                <a asp-area="Admin" asp-page="/DNS/Edit" class="btn btn-sm btn-outline-success">
                                    <i class="fa-solid fa-plus me-1"></i>Create New Pool
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>