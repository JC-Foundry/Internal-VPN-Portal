@page
@using VPN_Portal.Areas.Admin.Pages
@model VPN_Portal.Areas.Admin.Pages.PublicIp.IndexModel
@{
    ViewData["Title"] = "Public IP Address";
    ViewData["ActivePage"] = AdminNavPages.PublicIp;
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-gradient-primary text-white">
        <h4 class="mb-0 fw-semibold">
            <i class="fa-solid fa-globe me-2"></i>@ViewData["Title"]
        </h4>
    </div>
    <div class="card-body p-4">
        @if (!ModelState.IsValid)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
                <h6 class="alert-heading">
                    <i class="fa-solid fa-circle-exclamation me-2"></i>
                    <strong>Error</strong>
                </h6>
                <hr class="my-2">
                <ul class="mb-0 ps-3">
                    @foreach (var modelState in ViewData.ModelState.Values)
                    {
                        @foreach (var error in modelState.Errors)
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    }
                </ul>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (Model.ShowPasswordForm)
        {
            <!-- Password Authentication Form -->
            <div class="row justify-content-center">
                <div class="col-md-6">
                    <div class="text-center mb-4">
                        <i class="fa-solid fa-lock fa-3x text-warning mb-3"></i>
                        <h5 class="fw-semibold text-secondary mb-2">Authentication Required</h5>
                        <p class="text-muted small">This page contains sensitive network information and requires additional authentication.</p>
                    </div>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                        <div class="form-floating mb-4">
                            <input asp-for="Password"
                                   type="password"
                                   class="form-control form-control-lg rounded-3"
                                   autocomplete="off"
                                   placeholder="Enter password"
                                   autofocus/>
                            <label asp-for="Password" class="text-muted">
                                <i class="fa-solid fa-key me-1"></i>Access Password
                            </label>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg rounded-3">
                                <i class="fa-solid fa-unlock me-2"></i>Authenticate
                            </button>
                        </div>
                    </form>

                    <div class="alert alert-info rounded-3 mt-4" role="alert">
                        <i class="fa-solid fa-circle-info me-2"></i>
                        <small>Access tokens expire after 5 minutes for security.</small>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Public IP Display -->
            <div class="row justify-content-center">
                <div class="col-md-8">
                    @if (!string.IsNullOrEmpty(Model.PublicIp))
                    {
                        <div class="text-center mb-4">
                            <i class="fa-solid fa-network-wired fa-3x text-success mb-3"></i>
                            <h5 class="fw-semibold text-secondary mb-2">Current Public IP Address</h5>
                            <p class="text-muted small">Retrieved from MikroTik PPPoE Interface</p>
                        </div>

                        <div class="card bg-light border-0 mb-4">
                            <div class="card-body text-center py-4">
                                <div class="mb-3">
                                    <h2 class="fw-bold text-primary mb-0" id="publicIpAddress">@Model.PublicIp</h2>
                                </div>
                                <button type="button" class="btn btn-outline-primary rounded-3" onclick="copyIpAddress(this)">
                                    <i class="fa-solid fa-copy me-2"></i>Copy to Clipboard
                                </button>
                            </div>
                        </div>

                        @if (Model.TokenExpiry.HasValue)
                        {
                            var remainingTime = Model.TokenExpiry.Value - DateTime.UtcNow;
                            var minutes = (int)remainingTime.TotalMinutes;
                            var seconds = remainingTime.Seconds;

                            <div class="alert alert-warning rounded-3 mb-4" role="alert">
                                <i class="fa-solid fa-clock me-2"></i>
                                <strong>Access Expires In:</strong> @minutes minutes, @seconds seconds
                            </div>
                        }

                        <div class="text-center">
                            <a asp-page="/PublicIp/Index" class="btn btn-secondary rounded-3">
                                <i class="fa-solid fa-rotate me-2"></i>Re-authenticate
                            </a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function copyIpAddress(button) {
            const ipAddress = document.getElementById('publicIpAddress').textContent;
            navigator.clipboard.writeText(ipAddress).then(function() {
                // Show success feedback
                const originalHtml = button.innerHTML;
                button.innerHTML = '<i class="fa-solid fa-check me-2"></i>Copied!';
                button.classList.remove('btn-outline-primary');
                button.classList.add('btn-success');

                setTimeout(function() {
                    button.innerHTML = originalHtml;
                    button.classList.remove('btn-success');
                    button.classList.add('btn-outline-primary');
                }, 2000);
            }).catch(function(err) {
                console.error('Failed to copy: ', err);
                alert('Failed to copy to clipboard');
            });
        }
    </script>
}
