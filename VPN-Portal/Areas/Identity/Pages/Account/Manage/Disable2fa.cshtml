@page
@model Disable2faModel
@{
    ViewData["Title"] = "Disable Two-Factor Authentication";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-gradient-warning text-white">
        <h4 class="mb-0 fw-semibold">
            <i class="fa-solid fa-shield-xmark me-2"></i>@ViewData["Title"]
        </h4>
    </div>
    <div class="card-body p-4">
        <partial name="_StatusMessage" for="StatusMessage" />
        
        <div class="row">
            <div class="col-md-8">
                <div class="alert alert-warning rounded-3">
                    <i class="fa-solid fa-exclamation-triangle me-2"></i>
                    <strong>Important Information</strong>
                    <p class="mb-1 mt-2">This action only disables 2FA authentication.</p>
                    <p class="mb-0">
                        Disabling 2FA does not change the keys used in authenticator apps. If you wish to change the key
                        used in an authenticator app you should <a asp-page="./ResetAuthenticator" class="fw-bold">reset your authenticator keys</a>.
                    </p>
                </div>

                <form method="post">
                    <div class="d-grid gap-2">
                        <button class="btn btn-danger btn-lg rounded-3" type="submit">
                            <i class="fa-solid fa-shield-xmark me-2"></i>Disable 2FA
                        </button>
                        <a asp-page="./TwoFactorAuthentication" class="btn btn-outline-secondary btn-lg rounded-3">
                            <i class="fa-solid fa-arrow-left me-2"></i>Back to 2FA Settings
                        </a>
                    </div>
                </form>
            </div>
            
            <div class="col-md-4">
                <div class="card bg-light border-0">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">
                            <i class="fa-solid fa-info-circle me-1 text-primary"></i>What Happens Next?
                        </h6>
                        <p class="small text-muted mb-2">
                            After disabling 2FA:
                        </p>
                        <ul class="small text-muted mb-2">
                            <li>You'll only need your password to sign in</li>
                            <li>Authenticator apps will no longer be required</li>
                            <li>Recovery codes will remain valid until reset</li>
                        </ul>
                        <p class="small text-muted mb-0">
                            <strong>Security Note:</strong> Your account will be less secure without 2FA enabled.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
