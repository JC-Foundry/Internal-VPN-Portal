@inject SignInManager<ApplicationUser> SignInManager
@using VPN_Portal.Authentication
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}
<div class="list-group list-group-flush">
    <a class="list-group-item list-group-item-action d-flex align-items-center @(ManageNavPages.IndexNavClass(ViewContext) == "active" ? "bg-primary bg-opacity-10 border-start border-primary border-3 text-dark fw-semibold" : "")" 
       id="profile" asp-page="./Index">
        <i class="fa-solid fa-user me-3 @(ManageNavPages.IndexNavClass(ViewContext) == "active" ? "text-primary" : "text-muted")"></i>
        <span>Profile</span>
    </a>
    <a class="list-group-item list-group-item-action d-flex align-items-center @(ManageNavPages.EmailNavClass(ViewContext) == "active" ? "bg-primary bg-opacity-10 border-start border-primary border-3 text-dark fw-semibold" : "")" 
       id="email" asp-page="./Email">
        <i class="fa-solid fa-envelope me-3 @(ManageNavPages.EmailNavClass(ViewContext) == "active" ? "text-primary" : "text-muted")"></i>
        <span>Email</span>
    </a>
    <a class="list-group-item list-group-item-action d-flex align-items-center @(ManageNavPages.ChangePasswordNavClass(ViewContext) == "active" ? "bg-primary bg-opacity-10 border-start border-primary border-3 text-dark fw-semibold" : "")" 
       id="change-password" asp-page="./ChangePassword">
        <i class="fa-solid fa-key me-3 @(ManageNavPages.ChangePasswordNavClass(ViewContext) == "active" ? "text-primary" : "text-muted")"></i>
        <span>Password</span>
    </a>
    @if (hasExternalLogins)
    {
        <a class="list-group-item list-group-item-action d-flex align-items-center @(ManageNavPages.ExternalLoginsNavClass(ViewContext) == "active" ? "bg-primary bg-opacity-10 border-start border-primary border-3 text-dark fw-semibold" : "")" 
           id="external-login" asp-page="./ExternalLogins">
            <i class="fa-solid fa-link me-3 @(ManageNavPages.ExternalLoginsNavClass(ViewContext) == "active" ? "text-primary" : "text-muted")"></i>
            <span>External logins</span>
        </a>
    }
    <a class="list-group-item list-group-item-action d-flex align-items-center @(ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext) == "active" ? "bg-primary bg-opacity-10 border-start border-primary border-3 text-dark fw-semibold" : "")" 
       id="two-factor" asp-page="./TwoFactorAuthentication">
        <i class="fa-solid fa-shield-halved me-3 @(ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext) == "active" ? "text-primary" : "text-muted")"></i>
        <span>Two-factor authentication</span>
    </a>
    <a class="list-group-item list-group-item-action d-flex align-items-center @(ManageNavPages.PersonalDataNavClass(ViewContext) == "active" ? "bg-primary bg-opacity-10 border-start border-primary border-3 text-dark fw-semibold" : "")" 
       id="personal-data" asp-page="./PersonalData">
        <i class="fa-solid fa-database me-3 @(ManageNavPages.PersonalDataNavClass(ViewContext) == "active" ? "text-primary" : "text-muted")"></i>
        <span>Personal data</span>
    </a>
</div>