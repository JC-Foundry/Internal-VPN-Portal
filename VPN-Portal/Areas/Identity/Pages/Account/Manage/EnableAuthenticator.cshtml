@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Configure Authenticator App";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-gradient-primary text-white">
        <h4 class="mb-0 fw-semibold">
            <i class="fa-solid fa-mobile-screen-button me-2"></i>@ViewData["Title"]
        </h4>
    </div>
    <div class="card-body p-4">
        <partial name="_StatusMessage" for="StatusMessage" />
        
        <div class="row">
            <div class="col-md-8">
                <p class="text-muted mb-4">Follow these steps to set up your authenticator app for enhanced security:</p>
                
                <div class="accordion" id="setupAccordion">
                    <!-- Step 1: Download App -->
                    <div class="accordion-item border rounded-3 mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#step1">
                                <i class="fa-solid fa-download me-2 text-primary"></i>
                                <strong>Step 1: Download an Authenticator App</strong>
                            </button>
                        </h2>
                        <div id="step1" class="accordion-collapse collapse show">
                            <div class="accordion-body">
                                <p class="mb-3">Download a two-factor authenticator app:</p>
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <div class="card bg-light border-0">
                                            <div class="card-body text-center py-3">
                                                <h6 class="fw-bold mb-2">Microsoft Authenticator</h6>
                                                <div class="d-flex gap-2 justify-content-center">
                                                    <a href="https://go.microsoft.com/fwlink/?Linkid=825072" class="btn btn-sm btn-outline-success rounded-3" target="_blank">
                                                        <i class="fa-brands fa-android me-1"></i>Android
                                                    </a>
                                                    <a href="https://go.microsoft.com/fwlink/?Linkid=825073" class="btn btn-sm btn-outline-primary rounded-3" target="_blank">
                                                        <i class="fa-brands fa-apple me-1"></i>iOS
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="card bg-light border-0">
                                            <div class="card-body text-center py-3">
                                                <h6 class="fw-bold mb-2">Google Authenticator</h6>
                                                <div class="d-flex gap-2 justify-content-center">
                                                    <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=en" class="btn btn-sm btn-outline-success rounded-3" target="_blank">
                                                        <i class="fa-brands fa-android me-1"></i>Android
                                                    </a>
                                                    <a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8" class="btn btn-sm btn-outline-primary rounded-3" target="_blank">
                                                        <i class="fa-brands fa-apple me-1"></i>iOS
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2: Scan QR Code -->
                    <div class="accordion-item border rounded-3 mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#step2">
                                <i class="fa-solid fa-qrcode me-2 text-primary"></i>
                                <strong>Step 2: Scan QR Code or Enter Key</strong>
                            </button>
                        </h2>
                        <div id="step2" class="accordion-collapse collapse">
                            <div class="accordion-body">
                                <p class="mb-3">Scan the QR Code or manually enter this key into your authenticator app:</p>
                                
                                <div class="card bg-light border-0 mb-3">
                                    <div class="card-body text-center">
                                        <!-- QR Code Image -->
                                        <div class="mb-4">
                                            <img src="@Model.SharedKey" alt="QR Code" class="img-fluid rounded shadow-sm" style="max-width: 250px;" />
                                        </div>

                                        <!-- Manual Entry Key -->
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Manual Entry Key:</label>
                                            <div class="d-flex align-items-center gap-2 justify-content-center">
                                                <kbd class="p-2 bg-dark text-white rounded fs-6">@Model.FormattedKey</kbd>
                                                <button type="button" class="btn btn-outline-primary btn-sm rounded-3" onclick="copyToClipboard('@Model.FormattedKey.Replace(" ", "")')">
                                                    <i class="fa-solid fa-copy"></i>
                                                </button>
                                            </div>
                                            <small class="text-muted d-block mt-2">Spaces and casing do not matter</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3: Verify -->
                    <div class="accordion-item border rounded-3 mb-3">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#step3">
                                <i class="fa-solid fa-shield-check me-2 text-primary"></i>
                                <strong>Step 3: Verify Setup</strong>
                            </button>
                        </h2>
                        <div id="step3" class="accordion-collapse collapse">
                            <div class="accordion-body">
                                <p class="mb-3">
                                    Once you have scanned the QR code or input the key above, your two factor authentication app 
                                    will provide you with a unique code. Enter the code below to complete setup.
                                </p>
                                
                                <form id="send-code" method="post">
                                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>
                                    
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.Code" class="form-control form-control-lg rounded-3" autocomplete="off" placeholder="Verification Code"/>
                                        <label asp-for="Input.Code" class="text-muted">
                                            <i class="fa-solid fa-key me-1"></i>Verification Code
                                        </label>
                                        <span asp-validation-for="Input.Code" class="text-danger small"></span>
                                    </div>
                                    
                                    <div class="d-grid gap-2">
                                        <button type="submit" class="btn btn-primary btn-lg rounded-3">
                                            <i class="fa-solid fa-check me-2"></i>Verify and Enable
                                        </button>
                                        <a asp-page="./TwoFactorAuthentication" class="btn btn-outline-secondary btn-lg rounded-3">
                                            <i class="fa-solid fa-arrow-left me-2"></i>Back to 2FA Settings
                                        </a>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card bg-light border-0">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">
                            <i class="fa-solid fa-info-circle me-1 text-primary"></i>Setup Guide
                        </h6>
                        <p class="small text-muted mb-2">
                            Setting up an authenticator app adds an extra layer of security to your account.
                        </p>
                        <p class="small text-muted mb-2">
                            <strong>Tip:</strong> Complete all steps in order for successful setup.
                        </p>
                        <p class="small text-muted mb-0">
                            The verification code changes every 30 seconds, so enter it promptly.
                        </p>
                    </div>
                </div>
                
                <div class="card bg-light border-0 mt-3">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">
                            <i class="fa-solid fa-lightbulb me-1 text-warning"></i>Troubleshooting
                        </h6>
                        <p class="small text-muted mb-2">
                            <strong>Can't scan QR?</strong> Use the manual key entry method instead.
                        </p>
                        <p class="small text-muted mb-0">
                            <strong>Code not working?</strong> Ensure your device's time is synchronized.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(function() {
                // Show success feedback
                const button = event.target.closest('button');
                const originalHtml = button.innerHTML;
                button.innerHTML = '<i class="fa-solid fa-check"></i>';
                button.classList.remove('btn-outline-primary');
                button.classList.add('btn-success');

                setTimeout(function() {
                    button.innerHTML = originalHtml;
                    button.classList.remove('btn-success');
                    button.classList.add('btn-outline-primary');
                }, 2000);
            }).catch(function(err) {
                console.error('Failed to copy: ', err);
                alert('Failed to copy to clipboard');
            });
        }
    </script>
}
