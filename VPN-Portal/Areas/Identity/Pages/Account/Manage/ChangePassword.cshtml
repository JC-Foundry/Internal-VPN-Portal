@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-gradient-primary text-white">
        <h4 class="mb-0 fw-semibold">
            <i class="fa-solid fa-key me-2"></i>@ViewData["Title"]
        </h4>
    </div>
    <div class="card-body p-4">
        <partial name="_StatusMessage" for="StatusMessage" />
        
        <form id="change-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>
            
            <div class="row">
                <div class="col-md-8">
                    <div class="form-floating mb-3">
                        <input asp-for="Input.OldPassword" class="form-control form-control-lg rounded-3" autocomplete="current-password" aria-required="true" placeholder="Current Password" />
                        <label asp-for="Input.OldPassword" class="text-muted">
                            <i class="fa-solid fa-lock me-1"></i>Current Password
                        </label>
                        <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
                    </div>
                    
                    <div class="form-floating mb-3">
                        <input asp-for="Input.NewPassword" class="form-control form-control-lg rounded-3" autocomplete="new-password" aria-required="true" placeholder="New Password" />
                        <label asp-for="Input.NewPassword" class="text-muted">
                            <i class="fa-solid fa-lock-open me-1"></i>New Password
                        </label>
                        <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                    </div>
                    
                    <div class="form-floating mb-4">
                        <input asp-for="Input.ConfirmPassword" class="form-control form-control-lg rounded-3" autocomplete="new-password" aria-required="true" placeholder="Confirm New Password"/>
                        <label asp-for="Input.ConfirmPassword" class="text-muted">
                            <i class="fa-solid fa-check-double me-1"></i>Confirm New Password
                        </label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>
                    
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg rounded-3">
                            <i class="fa-solid fa-floppy-disk me-2"></i>Update Password
                        </button>
                    </div>
                </div>
                
                <div class="col-md-4">
                    <div class="card bg-light border-0">
                        <div class="card-body">
                            <h6 class="fw-bold mb-3">
                                <i class="fa-solid fa-shield-halved me-1 text-primary"></i>Password Security
                            </h6>
                            <p class="small text-muted mb-2">
                                Choose a strong password with at least 8 characters, including uppercase, lowercase, numbers, and special characters.
                            </p>
                            <p class="small text-muted mb-0">
                                Regular password changes help maintain account security.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
