@page
@model SetPasswordModel
@{
    ViewData["Title"] = "Set Password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-gradient-primary text-white">
        <h4 class="mb-0 fw-semibold">
            <i class="fa-solid fa-key me-2"></i>@ViewData["Title"]
        </h4>
    </div>
    <div class="card-body p-4">
        <partial name="_StatusMessage" for="StatusMessage" />
        
        <div class="row">
            <div class="col-md-8">
                <div class="alert alert-info rounded-3">
                    <i class="fa-solid fa-info-circle me-2"></i>
                    <strong>Create a Local Password</strong>
                    <p class="mb-0 mt-2">
                        You do not have a local username/password for this site. Add a local account so you can log in without an external login provider.
                    </p>
                </div>

                <form id="set-password-form" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>
                    
                    <div class="form-floating mb-3">
                        <input asp-for="Input.NewPassword" class="form-control form-control-lg rounded-3" autocomplete="new-password" placeholder="New Password"/>
                        <label asp-for="Input.NewPassword" class="text-muted">
                            <i class="fa-solid fa-lock me-1"></i>New Password
                        </label>
                        <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                    </div>
                    
                    <div class="form-floating mb-4">
                        <input asp-for="Input.ConfirmPassword" class="form-control form-control-lg rounded-3" autocomplete="new-password" placeholder="Confirm Password"/>
                        <label asp-for="Input.ConfirmPassword" class="text-muted">
                            <i class="fa-solid fa-check-double me-1"></i>Confirm Password
                        </label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>
                    
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg rounded-3">
                            <i class="fa-solid fa-floppy-disk me-2"></i>Set Password
                        </button>
                        <a asp-page="./Index" class="btn btn-outline-secondary btn-lg rounded-3">
                            <i class="fa-solid fa-arrow-left me-2"></i>Back to Profile
                        </a>
                    </div>
                </form>
            </div>
            
            <div class="col-md-4">
                <div class="card bg-light border-0">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">
                            <i class="fa-solid fa-shield-halved me-1 text-primary"></i>Password Security
                        </h6>
                        <p class="small text-muted mb-2">
                            Creating a local password provides an additional way to access your account.
                        </p>
                        <p class="small text-muted mb-2">
                            <strong>Password Requirements:</strong>
                        </p>
                        <ul class="small text-muted mb-2">
                            <li>At least 8 characters long</li>
                            <li>Include uppercase and lowercase letters</li>
                            <li>Include numbers and special characters</li>
                        </ul>
                        <p class="small text-muted mb-0">
                            <strong>Tip:</strong> Use a unique password that you don't use elsewhere.
                        </p>
                    </div>
                </div>
                
                <div class="card bg-light border-0 mt-3">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">
                            <i class="fa-solid fa-lightbulb me-1 text-warning"></i>Benefits
                        </h6>
                        <p class="small text-muted mb-2">
                            With a local password you can:
                        </p>
                        <ul class="small text-muted mb-0">
                            <li>Sign in even if external providers are unavailable</li>
                            <li>Have backup access to your account</li>
                            <li>Use password managers for convenience</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
