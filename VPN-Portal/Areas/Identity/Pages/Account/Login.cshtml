@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="container">
    <div class="row justify-content-center align-items-center my-5">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-header bg-gradient-primary text-white text-center py-4 rounded-top-4">
                    <h2 class="mb-1 fw-bold">
                        <i class="fa-solid fa-shield-halved me-2"></i>VPN Portal
                    </h2>
                    <p class="mb-0 opacity-75">Secure Access Gateway</p>
                </div>
                
                <div class="card-body p-4 p-md-5">
                    <h3 class="text-center mb-4 fw-semibold text-secondary">Welcome Back</h3>
                    
                    <form id="account" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>
                        
                        <div class="form-floating mb-3">
                            <input asp-for="Input.Username" class="form-control form-control-lg rounded-3" autocomplete="username" aria-required="true" placeholder="Username" />
                            <label asp-for="Input.Username" class="text-muted">
                                <i class="fa-solid fa-user me-1"></i>Username
                            </label>
                            <span asp-validation-for="Input.Username" class="text-danger small"></span>
                        </div>
                        
                        <div class="form-floating mb-4">
                            <input asp-for="Input.Password" class="form-control form-control-lg rounded-3" autocomplete="current-password" aria-required="true" placeholder="Password" />
                            <label asp-for="Input.Password" class="text-muted">
                                <i class="fa-solid fa-lock me-1"></i>Password
                            </label>
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>
                        
                        <div class="form-check mb-4">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label asp-for="Input.RememberMe" class="form-check-label text-muted">
                                Remember me
                            </label>
                        </div>
                        
                        <div class="d-grid gap-2">
                            <button id="login-submit" type="submit" class="btn btn-primary btn-lg rounded-3 shadow-sm">
                                <i class="fa-solid fa-right-to-bracket me-2"></i>Sign In
                            </button>
                        </div>
                    </form>
                </div>
                
                <div class="card-footer bg-light text-center py-3 rounded-bottom-4">
                    <small class="text-muted">
                        <i class="fa-solid fa-lock me-1"></i>Secure connection
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>