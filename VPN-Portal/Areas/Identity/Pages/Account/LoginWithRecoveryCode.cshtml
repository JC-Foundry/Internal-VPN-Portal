@page
@model LoginWithRecoveryCodeModel

@{
    ViewData["Title"] = "Recovery code verification";
}

<div class="container">
    <div class="row justify-content-center align-items-center my-5">
        <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-header bg-gradient-primary text-white text-center py-4 rounded-top-4">
                    <h2 class="mb-1 fw-bold">
                        <i class="fa-solid fa-shield-halved me-2"></i>VPN Portal
                    </h2>
                    <p class="mb-0 opacity-75">Recovery Code Verification</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <i class="fa-solid fa-key fa-3x text-warning mb-3"></i>
                        <h3 class="fw-semibold text-secondary mb-2">Enter Recovery Code</h3>
                        <p class="text-muted small">You are attempting to log in with a recovery code. This code can only be used once.</p>
                    </div>

                    <form method="post">
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.RecoveryCode"
                                   class="form-control form-control-lg rounded-3 text-center"
                                   autocomplete="off"
                                   aria-required="true"
                                   placeholder="Enter recovery code"
                                   autofocus />
                            <label asp-for="Input.RecoveryCode" class="text-muted">
                                <i class="fa-solid fa-shield-keyhole me-1"></i>Recovery Code
                            </label>
                            <span asp-validation-for="Input.RecoveryCode" class="text-danger small"></span>
                        </div>

                        <div class="alert alert-warning rounded-3 mb-4" role="alert">
                            <i class="fa-solid fa-triangle-exclamation me-2"></i>
                            <strong>Warning:</strong> This recovery code will be invalidated after use. Consider regenerating your recovery codes after logging in.
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-3 shadow-sm">
                                <i class="fa-solid fa-right-to-bracket me-2"></i>Verify & Sign In
                            </button>
                        </div>
                    </form>
                </div>

                <div class="card-footer bg-light text-center py-3 rounded-bottom-4">
                    <small class="text-muted">
                        <i class="fa-solid fa-shield-check me-1"></i>Secure recovery authentication
                    </small>
                </div>
            </div>

            <!-- Help Text -->
            <div class="text-center mt-4">
                <p class="text-muted small">
                    <i class="fa-solid fa-circle-info me-1"></i>
                    Recovery codes are provided when you enable two-factor authentication.
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
